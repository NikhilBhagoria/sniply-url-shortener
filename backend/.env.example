MONGO_URI=mongodb://127.0.0.1:27017/sniply
# Required: generate a random secret of at least 32 characters; do not commit .env.
JWT_SECRET=
JWT_EXPIRES=7d
NODE_ENV=development
PORT=5000
# Single frontend origin used in email and redirect links.
CLIENT_URL=http://localhost:5173
# Optional comma-separated browser origins. Defaults to CLIENT_URL.
CORS_ORIGINS=http://localhost:5173
BASE_URL=http://localhost:5000
# Set to the exact reverse-proxy hop count for your hosting topology.
TRUST_PROXY=0
# Local Mailpit: SMTP 1025, inbox UI 8025. Production: configure your SMTP provider.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Sniply <no-reply@example.test>
