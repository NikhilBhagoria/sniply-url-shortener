# MongoDB Connection URI (e.g. MongoDB Atlas cluster string or local database)
MONGO_URI=mongodb://localhost:27017/sniply

# Production Secret Key (use strong 64-char random string)
JWT_SECRET=replace_with_a_long_random_string

# Token Expiry (e.g. 7d, 24h)
JWT_EXPIRES=7d

# Server HTTP Port
PORT=5000

# Frontend Client URL for CORS & Password Unlock redirects (no trailing slash)
CLIENT_URL=http://localhost:5173

# Base Domain URL for generated Short Links (e.g. https://snip.ly or backend host)
BASE_URL=http://localhost:5000
